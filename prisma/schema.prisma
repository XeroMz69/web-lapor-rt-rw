generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================
// Pengurus RT/RW — yang berhak update laporan
// ============================================
model Pengurus {
  id          String   @id @default(cuid())
  nama        String
  jabatan     String   // Ketua RT, Sekretaris, dll
  noWhatsapp  String   @unique // format: 628xxx (tanpa +)
  aktif       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  updates    LaporanUpdate[]
  kasDicatat KasTransaksi[]

  @@map("pengurus")
}

// ============================================
// Laporan Warga
// ============================================
model Laporan {
  id          String   @id @default(cuid())
  kode        String   @unique // LP-0001, LP-0002, dst (auto-generate)
  nama        String?  @default("Anonim") // bersifat anonim
  noHp        String?  @default("-")
  kategori    String   // JALAN_RUSAK, SAMPAH, PENERANGAN, dll
  judul       String
  deskripsi   String
  fotoUrl     String   // URL / path foto
  latitude    Float
  longitude   Float
  alamat      String?
  status      String   @default("PENDING") // PENDING, DIPROSES, SELESAI, DITOLAK
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Voting Urgency Counts
  voteRendahCount    Int @default(0)
  voteSedangCount    Int @default(0)
  voteTinggiCount    Int @default(0)
  voteCriticalCount  Int @default(0)

  updates   LaporanUpdate[]
  transaksi KasTransaksi[]

  @@map("laporan")
}

// ============================================
// Update/Tindak Lanjut dari Pengurus
// ============================================
model LaporanUpdate {
  id          String   @id @default(cuid())
  laporanId   String
  pengurusId  String
  status      String   // PENDING, DIPROSES, SELESAI, DITOLAK
  keterangan  String
  fotoUrl     String?
  createdAt   DateTime @default(now())

  laporan  Laporan  @relation(fields: [laporanId], references: [id], onDelete: Cascade)
  pengurus Pengurus @relation(fields: [pengurusId], references: [id])

  @@map("laporan_update")
}

// ============================================
// Transparansi Kas Lingkungan RT/RW
// ============================================
model KasTransaksi {
  id          String   @id @default(cuid())
  tipe        String   // PEMASUKAN atau PENGELUARAN
  nominal     Float
  kategori    String   // Iuran Warga, Perbaikan Jalan, Sampah, dll
  keterangan  String
  buktiUrl    String?
  tanggal     DateTime @default(now())
  
  laporanId   String?
  laporan     Laporan? @relation(fields: [laporanId], references: [id], onDelete: SetNull)

  pengurusId  String?
  pengurus    Pengurus? @relation(fields: [pengurusId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())

  @@map("kas_transaksi")
}
