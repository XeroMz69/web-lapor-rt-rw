generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================
// Pengurus RT/RW — yang berhak update laporan
// ============================================
model Pengurus {
  id          String   @id @default(cuid())
  nama        String
  jabatan     String   // Ketua RT, Sekretaris, dll
  noWhatsapp  String   @unique // format: 628xxx (tanpa +)
  aktif       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  updates LaporanUpdate[]
  kasDicatat KasTransaksi[]

  @@map("pengurus")
}

// ============================================
// Laporan Warga
// ============================================
model Laporan {
  id          String        @id @default(cuid())
  kode        String        @unique // LP-0001, LP-0002, dst (auto-generate)
  nama        String?       @default("Anonim") // bersifat anonim
  noHp        String?       @default("-")
  kategori    Kategori
  judul       String
  deskripsi   String        @db.Text
  fotoUrl     String        // path relatif: /uploads/laporan/xxx.jpg
  latitude    Float
  longitude   Float
  alamat      String?       @db.Text
  status      Status        @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  updates   LaporanUpdate[]
  transaksi KasTransaksi[]

  @@map("laporan")
}

// ============================================
// Update/Tindak Lanjut dari Pengurus
// ============================================
model LaporanUpdate {
  id          String   @id @default(cuid())
  laporanId   String
  pengurusId  String
  status      Status
  keterangan  String   @db.Text
  fotoUrl     String?  // path relatif: /uploads/update/xxx.jpg
  createdAt   DateTime @default(now())

  laporan  Laporan  @relation(fields: [laporanId], references: [id], onDelete: Cascade)
  pengurus Pengurus @relation(fields: [pengurusId], references: [id])

  @@map("laporan_update")
}

// ============================================
// Transparansi Kas Lingkungan RT/RW
// ============================================
model KasTransaksi {
  id          String         @id @default(cuid())
  tipe        TipeTransaksi  // PEMASUKAN atau PENGELUARAN
  nominal     Float
  kategori    String         // Iuran Warga, Perbaikan Jalan, Sampah, Dana Sosial, dll
  keterangan  String         @db.Text
  buktiUrl    String?        // path bukti nota/kuitansi/struk
  tanggal     DateTime       @default(now())
  
  // Hubungan opsional ke laporan tertentu (misal pengeluaran untuk tambal jalan LP-0001)
  laporanId   String?
  laporan     Laporan?       @relation(fields: [laporanId], references: [id], onDelete: SetNull)

  // Pengurus pencatat transaksi
  pengurusId  String?
  pengurus    Pengurus?      @relation(fields: [pengurusId], references: [id], onDelete: SetNull)

  createdAt   DateTime       @default(now())

  @@map("kas_transaksi")
}

// ============================================
// Enums
// ============================================
enum TipeTransaksi {
  PEMASUKAN
  PENGELUARAN
}

enum Status {
  PENDING
  DIPROSES
  SELESAI
  DITOLAK
}

enum Kategori {
  JALAN_RUSAK
  SAMPAH
  PENERANGAN
  SALURAN_AIR
  FASILITAS_UMUM
  KEAMANAN
  LAINNYA
}
