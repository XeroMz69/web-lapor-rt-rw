{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sipena-civil",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
    "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issues": {
      "enabled": true
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sipena-civil",
      "database_id": "20c17012-d742-4afa-bf3b-855f710c27b8"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "sipena-civil"
    }
  ],
  "vars": {
    "BOT_SERVICE_URL": "https://bot.adamyd.my.id",
    "EMERGENCY_CONTACT_PHONE": "628123456789",
    "EMERGENCY_CONTACT_NAME": "Pengurus RT/RW (Call Center)",
    "MEDIA_PUBLIC_URL": "https://s3-sipena-civil.adamyd.my.id"
  }
}